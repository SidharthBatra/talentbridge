# ---- TalentBridge backend environment ----
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# App
PORT=3000
NODE_ENV=development

# Database (used directly by TypeORM DataSource & @nestjs/typeorm)
# When running via docker-compose, host is the service name `postgres`.
DATABASE_URL=postgres://talentbridge:talentbridge@localhost:5432/talentbridge

# JWT secrets — generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenRouter (used by the AI module — placeholder here so the whole
# team shares one .env contract). Not consumed by the foundation module.
OPENROUTER_API_KEY=change_me_openrouter_key
