{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/modules/**/*.controller.ts",
    "src/modules/**/*.service.ts"
  ],
  "coverageDirectory": "coverage-e2e"
}
